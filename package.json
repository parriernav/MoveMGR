{
  "name": "movemgr",
  "private": true,
  "version": "0.0.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "node scripts/prepare-build.mjs && tauri dev",
