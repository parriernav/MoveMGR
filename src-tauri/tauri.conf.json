{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoveMgr",
  "version": "0.0.21",
  "identifier": "com.movemgr.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MoveMgr ver.0.0.21",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "maximized": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Rule-based file organizer",
    "longDescription": "Safely sort and move files from source folders on Windows and macOS with reusable rules.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
